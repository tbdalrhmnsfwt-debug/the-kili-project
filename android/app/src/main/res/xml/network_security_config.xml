<?xml version="1.0" encoding="utf-8"?>
<!--
  The app only talks to https://students.moalemai.com (see lib/core/api_client.dart),
  so cleartext traffic is refused everywhere and the platform trust store is used.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
