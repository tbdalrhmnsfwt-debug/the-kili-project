# Release builds keep R8 minification disabled (isMinifyEnabled = false in the
# Gradle module generated by CI), so these rules are inert. They are kept here
# so the app stays correct if minification is ever enabled.
#
# Entry points below are reachable only from native code or reflection and
# would otherwise be stripped.

# flutter_tesseract_ocr and the bundled tesseract4android AAR load their native
# libraries and call back into Java.
-keep class io.paratoner.flutter_tesseract_ocr.** { *; }
-keep class cz.adaptech.tesseract4android.** { *; }
-keep class com.googlecode.tesseract.android.** { *; }
-keep class com.googlecode.leptonica.android.** { *; }

# Components instantiated from AndroidManifest.xml (the activity, the two
# foreground services and the four widget receivers) and classes reached over
# the zaker/ai_jobs MethodChannel.
-keep class com.zaker.zaker_ai.** { *; }
